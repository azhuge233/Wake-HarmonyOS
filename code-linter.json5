{
  "files": [
    "**/*.ets"
  ],
  "ignore": [
    "**/src/ohosTest/**/*",
    "**/src/test/**/*",
    "**/src/mock/**/*",
    "**/node_modules/**/*",
    "**/oh_modules/**/*",
    "**/build/**/*",
    "**/.preview/**/*"
  ],
  "ruleSet": [
    "plugin:@performance/recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
  },
  "overrides": [
    {
      // 这些文件的 await 目标均为 async/Promise，CodeLinter 类型推断误报；只关闭本规则，保留其余检查
      "files": [
        "entry/src/main/ets/ability/MultipleDevicesFormAbility.ets",
        "entry/src/main/ets/ability/MultipleDevicesWidgetEntryAbility.ets",
        "entry/src/main/ets/ability/SingleDeviceFormAbility.ets",
        "entry/src/main/ets/ability/SingleDeviceWidgetEntryAbility.ets",
        "entry/src/main/ets/data/AddressResolver.ets",
        "entry/src/main/ets/data/CardBindingStore.ets",
        "entry/src/main/ets/data/CardPublisher.ets",
        "entry/src/main/ets/data/DeviceDao.ets",
        "entry/src/main/ets/data/NeighborTableReader.ets",
        "entry/src/main/ets/data/SettingsStore.ets",
        "entry/src/main/ets/data/WakeSender.ets",
        "entry/src/main/ets/ui/pages/AddDevice.ets",
        "entry/src/main/ets/ui/pages/Index.ets",
        "entry/src/main/ets/viewmodel/DeviceListViewModel.ets"
      ],
      "rules": {
        "@typescript-eslint/await-thenable": "off"
      }
    }
  ]
}