{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "compressNativeLibs": true,
    "deliveryWithInstall": true,
    "installationFree": false,
    "routerMap": "$profile:route_map",
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon_layered",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ]
      },
      {
        "name": 'SingleDeviceWidgetEntryAbility',
        "srcEntry": "./ets/singledevicewidget/singledevicewidgetentryability/SingleDeviceWidgetEntryAbility.ets",
        "description": '$string:SingleDeviceWidgetEntryAbility_desc',
        "icon": "$media:app_icon_layered",
        "label": "$string:SingleDeviceWidgetEntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "multiton"
      },
      {
        "name": 'MultipleDevicesWidgetEntryAbility',
        "srcEntry": "./ets/multipledeviceswidget/multipledeviceswidgetentryability/MultipleDevicesWidgetEntryAbility.ets",
        "description": '$string:MultipleDevicesWidgetEntryAbility_desc',
        "icon": "$media:app_icon_layered",
        "label": "$string:MultipleDevicesWidgetEntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "multiton"
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
      {
        "name": "SingleDeviceFormAbility",
        "srcEntry": "./ets/singledevicewidget/singledeviceformability/SingleDeviceFormAbility.ets",
        "label": "$string:SingleDeviceFormAbility_label",
        "description": "$string:SingleDeviceFormAbility_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:single_device_form_config"
          }
        ]
      },
      {
        "name": "MultipleDevicesFormAbility",
        "srcEntry": "./ets/multipledeviceswidget/multipledevicesformability/MultipleDevicesFormAbility.ets",
        "label": "$string:MultipleDevicesFormAbility_label",
        "description": "$string:MultipleDevicesFormAbility_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:multiple_devices_form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_WIFI_INFO",
        "reason": "$string:network_permission_reason"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:network_permission_reason"
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:network_permission_reason"
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrate_permission_reason"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:background_permission_reason"
      }
    ]
  }
}